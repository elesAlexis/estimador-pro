# Configuración pública: estos valores pueden aparecer en la aplicación compilada.
VITE_GITLAB_URL=https://gitlab.example.com
VITE_GITLAB_PROJECT=grupo/proyecto
VITE_GITLAB_CLIENT_ID=
# Ruta exacta del sitio Pages, terminada en /. Usar / con un dominio único.
VITE_BASE_PATH=/
# No poner tokens, contraseñas ni Client Secret en variables VITE_.

# Docker Compose
APP_PORT=18082
# Genera un valor aleatorio para .env. Solo se usa entre los dos servidores.
STORAGE_API_TOKEN=
